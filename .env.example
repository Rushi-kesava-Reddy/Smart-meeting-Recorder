# =============================================================================
# Multilingual AI Smart Meeting Recorder & Assistant - Environment Config
# =============================================================================
# Copy this file to .env for local development:
# cp .env.example .env

# Groq Cloud API Key for Whisper Speech Recognition & LLM Summarization/Translation
# Sign up and generate a free API key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Secret Key for Flask sessions and cookies (replace with a secure random string)
SECRET_KEY=smart_meeting_recorder_random_secret_key_change_in_production

# Application Host (0.0.0.0 binds to all network interfaces for external/cloud access)
HOST=0.0.0.0

# Application Port (Render sets this automatically in production)
PORT=5000

# Flask Debug Mode (Set to False in production)
FLASK_DEBUG=False
