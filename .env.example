# Smart Meeting Recorder - Environment Configuration Example
# Copy this file to .env for local development:
# cp .env.example .env

# Secret Key for Flask sessions (replace with a strong random string in production)
SECRET_KEY=your_secret_key_here_change_in_production

# Application Host (0.0.0.0 listens on all network interfaces for external access)
HOST=0.0.0.0

# Application Port (Render sets this automatically in production)
PORT=5000

# Flask Debug Mode (Set to False in production)
FLASK_DEBUG=False
